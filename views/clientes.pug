extends layout
include mixins

block content
  section#seccionForm.tarjeta(data-roles="administrativo" hidden)
    h3#tituloForm Nuevo cliente
    form#formulario(novalidate)
      +campo("Nombre", "nombre", "text")
      +campo("Email", "email", "email")
      +campo("Direccion", "direccion", "text")
      +campo("Telefono", "telefono", "text")
      ul#erroresForm.errores(hidden)
      button#btnGuardar(type="submit") Guardar
      button#btnCancelar(type="button", hidden) Cancelar edicion
  section.tarjeta
    h3 Listado
    +filtroInactivos
    table
      thead
        tr
          th Nombre
          th Email
          th Direccion
          th Telefono
          th Estado
          th Ultima modificacion
          th Acciones
      tbody#tabla

block scripts
  script(type="module", src="/js/clientes.js")
