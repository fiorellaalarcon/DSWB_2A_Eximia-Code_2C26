doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{titulo} - FreshRoute
    link(rel="stylesheet", href="/css/styles.css")
  body
    header.site-header
      .container
        h1 FreshRoute
        p Distribucion de pedidos - Eximia Code
        //- El menu lo construye public/js/auth.js segun el rol del usuario.
        nav#menu
    main.container
      h2= titulo
      //- Area de mensajes de exito / error (la actualiza ui.js, sin recargar).
      #mensaje(role="status", aria-live="polite", hidden)
      block content
    footer.site-footer
      .container
        p Segundo parcial - Desarrollo de Sistemas Web (Back End) 2A - Eximia Code
    block scripts
