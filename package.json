{
  "name": "freshroute-eximia-code",
  "version": "1.1.3",
  "description": "Entrega final - Caso 2: FreshRoute (Node.js + Express + MongoDB Atlas + Mongoose + Pug + JWT + Socket.IO + Gemini)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "seed": "node scripts/seed.js",
    "secret": "node --input-type=module -e \"import {randomBytes} from 'node:crypto'; console.log(randomBytes(48).toString('hex'))\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "node --test \"test/integration/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "pug": "^3.0.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4"
  },
  "jest": {
    "testMatch": [
      "**/test/unit/**/*.test.js"
    ],
    "transform": {}
  }
}
