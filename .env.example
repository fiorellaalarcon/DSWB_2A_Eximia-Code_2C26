# Copiar este archivo como ".env" y completar los valores.
# El archivo ".env" real NO se sube a GitHub (esta en .gitignore).

PORT=3000
NODE_ENV=development

# --- Base de datos ---------------------------------------------------------
# Opcion A (desarrollo): MongoDB local, visible desde MongoDB Compass.
MONGO_URI=mongodb://127.0.0.1:27017/freshroute
# Opcion B (entrega final): MongoDB Atlas. Reemplazar USUARIO, CLAVE y el host de su cluster.
# MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/freshroute?retryWrites=true&w=majority

# Base separada para los tests (no ensucia los datos reales).
MONGO_URI_TEST=mongodb://127.0.0.1:27017/freshroute_test

# --- Seguridad -------------------------------------------------------------
# Secreto con el que se firma el JWT (minimo 32 caracteres). Generar uno con:  npm run secret
JWT_SECRET=cambiar-por-un-secreto-largo-generado-con-npm-run-secret

# --- Asistente de IA (Gemini) ----------------------------------------------
# Clave de https://aistudio.google.com/ . Si se deja vacia, el chat funciona pero @gemini avisa que no esta configurado.
GEMINI_API_KEY=a
# Opcional: modelo a usar (por defecto gemini-2.5-flash). Verificar en Google AI Studio cual esta vigente.
GEMINI_MODEL=gemini-2.5-flash
