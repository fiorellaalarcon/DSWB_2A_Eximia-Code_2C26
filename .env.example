# Copiar este archivo como ".env" y completar los valores.
# El archivo ".env" real NO se sube a GitHub (esta en .gitignore).

PORT=3000

# Opcion A (utilizada en esta entrega): MongoDB local, visible desde MongoDB Compass.
MONGO_URI=mongodb://127.0.0.1:27017/freshroute

# Opcion B (a utilizar en la tercera entrega): MongoDB Atlas. Solo cambia esta linea, el codigo no se toca.
# MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/freshroute

# Base separada para los tests (para no ensuciar los datos reales).
MONGO_URI_TEST=mongodb://127.0.0.1:27017/freshroute_test
